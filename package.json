{
  "name": "@otoji/core",
  "version": "0.1.3",
  "packageManager": "bun@1.3.13",
  "description": "音字 — realtime speech ⇄ text. Node/Bun bindings for the otoji Rust crate (SenseVoice ASR + multilingual polish + TTS).",
  "license": "MIT",
  "author": "snomiao <snomiao@gmail.com>",
  "homepage": "https://github.com/snomiao/otoji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snomiao/otoji.git"
  },
  "bugs": {
    "url": "https://github.com/snomiao/otoji/issues"
  },
  "keywords": [
    "asr",
    "speech-to-text",
    "stt",
    "tts",
    "sensevoice",
    "realtime",
    "japanese",
    "chinese",
    "multilingual",
    "transcription",
    "napi-rs"
  ],
  "main": "main.js",
  "types": "main.d.ts",
  "bin": {
    "otoji-node": "cli/otoji-node.mjs"
  },
  "files": [
    "main.js",
    "main.d.ts",
    "index.js",
    "index.d.ts",
    "*.node",
    "cli/otoji-node.mjs",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "name": "core",
    "package": {
      "name": "@otoji/core"
    },
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features node --cargo-flags=--lib",
    "build:debug": "napi build --platform --features node --cargo-flags=--lib",
    "build:release": "napi build --platform --release --features node --cargo-flags=--lib --strip",
    "prepublishOnly": "napi prepublish -t npm && bun run build:release",
    "prepack": "bun run build:release",
    "prepare": "test -n \"$CI\" -o -f index.js || bun run build || true",
    "test": "cargo test",
    "test:smoke": "node -e \"require('./main.js'); console.log('otoji loaded OK');\"",
    "version": "napi version",
    "universal": "napi universal",
    "clean": "rm -f *.node index.js index.d.ts npm/**/*.node"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "engines": {
    "node": ">= 18"
  },
  "optionalDependencies": {
    "@otoji/core-darwin-arm64": "0.1.3",
    "@otoji/core-darwin-x64": "0.1.3",
    "@otoji/core-linux-x64-gnu": "0.1.3",
    "@otoji/core-linux-arm64-gnu": "0.1.3",
    "@otoji/core-win32-x64-msvc": "0.1.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
