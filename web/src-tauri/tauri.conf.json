{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "otoji",
  "version": "0.1.16",
  "identifier": "com.snomiao.otoji",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "otoji — local SenseVoice",
        "width": 980,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/otoji"],
    "category": "Productivity",
    "shortDescription": "Local SenseVoice speech-to-text",
    "longDescription": "Fully-local realtime speech-to-text powered by SenseVoice. Runs an offline ASR server bundled inside the app — no API keys, no cloud."
  }
}
