{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the otoji desktop app: run the bundled otoji server sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/otoji",
          "sidecar": true,
          "args": ["server"]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/otoji",
          "sidecar": true,
          "args": ["server"]
        }
      ]
    }
  ]
}
