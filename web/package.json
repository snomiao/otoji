{
  "name": "otoji-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsgo --noEmit",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "preview:fresh": "bun run build && vite preview --strictPort --port 5185",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "wrangler pages deploy dist --project-name=otoji",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:userscript": "tsx userscript/build.ts"
  },
  "dependencies": {
    "@gutenye/ocr-browser": "^1.4.8",
    "blueimp-md5": "^2.19.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lz-string": "^1.5.0",
    "marked": "^12.0.0",
    "monaco-editor": "^0.55.1",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "@typescript/native-preview": "7.0.0-dev.20260627.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@webgpu/types": "^0.1.71",
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.0",
    "tsx": "^4.16.0",
    "vite": "^5.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.2"
  }
}
