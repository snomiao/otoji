{
  "name": "otoji-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsgo --noEmit",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "wrangler pages deploy dist --project-name=otoji",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:userscript": "tsx userscript/build.ts"
  },
  "dependencies": {
    "@gutenye/ocr-browser": "^1.4.8",
    "blueimp-md5": "^2.19.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "marked": "^12.0.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260627.2",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.0.2"
  }
}
