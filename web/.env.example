# These are NOT loaded by Vite. They document what keys the user can paste
# into the in-app Settings panel. Everything is BYOK, stored in browser localStorage.

# iFlytek RTASR (streaming ASR)
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=

# iFlytek TTS
IFLYTEK_TTS_API_KEY=
IFLYTEK_TTS_API_SECRET=
IFLYTEK_TTS_VOICE=xiaoyan
IFLYTEK_TTS_AUE=lame

# OpenAI (Whisper STT + TTS + chat polish)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude polish)
# Browser calls require: anthropic-dangerous-direct-browser-access: true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Docs export (BYOK OAuth access token)
GOOGLE_OAUTH_TOKEN=
GOOGLE_DOC_ID=
